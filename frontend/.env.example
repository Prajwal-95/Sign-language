# Frontend environment configuration.
#
# Copy to `.env.local` (git-ignored) for local development.
# Never put secrets here — everything in a VITE_* variable is inlined into the
# client bundle.

# Base URL of the FastAPI backend.
#
# Development (optional): defaults to http://localhost:8000 when unset.
# Production (optional): defaults to the current origin when unset.
#
# The WebSocket URL is derived from this value in src/services/ws.ts:
#   http://  -> ws://
#   https:// -> wss://
# so an HTTPS deployment over an HTTPS backend connects with secure sockets
# automatically. There is no separate VITE_WS_URL.
#
# Examples:
#   VITE_API_BASE_URL=https://isl-api.example.com
#   VITE_API_BASE_URL=https://api.example.com/isl     (path prefixes are supported)
#   VITE_API_BASE_URL=http://192.168.1.20:8000         (LAN device testing)
VITE_API_BASE_URL=

# Address of the local offline speech service that reads Hindi and Kannada
# aloud, because Windows 11 installs no voices for those languages.
# See tools/tts-service/README.md — run its install.bat once, then run.bat.
#
# Development (optional): defaults to http://127.0.0.1:8765 when unset.
# It only has to change if you start the service on a different port.
VITE_LOCAL_TTS_URL=