# Copy this file to .env and adjust values for your machine.
# Created automatically by run.bat on first launch.

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model (used from Phase 6 onward)
MODEL_PATH=../models/model.pkl
FEATURES_PATH=../models/features.json
CONFIDENCE_THRESHOLD=0.60

# Dataset (used from Phase 3 onward)
DATASET_RAW_PATH=../dataset/raw
DATASET_PROCESSED_PATH=../dataset/processed